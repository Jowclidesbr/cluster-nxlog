global_defs {
  router_id {{ inventory_hostname | upper | replace('-', '_') }}
  enable_script_security
  script_user root
}

vrrp_script chk_nxlog {
  script "/usr/local/libexec/cluster-ha-nxlog/check_nxlog.sh"
  interval 2
  fall 2
  rise 2
  weight -60
}

vrrp_instance VI_NXLOG {
  state BACKUP
  interface {{ cluster_interface }}
  virtual_router_id {{ cluster_vrrp_router_id }}
  priority {{ cluster_priority[inventory_hostname] }}
  advert_int 1
  authentication {
    auth_type PASS
    auth_pass {{ cluster_vrrp_password }}
  }
  unicast_src_ip {{ cluster_unicast_src[inventory_hostname] }}
  unicast_peer {
    {{ cluster_unicast_src[peer_name] }}
  }
  virtual_ipaddress {
    {{ cluster_vip }}/{{ cluster_vip_cidr }} dev {{ cluster_interface }}
  }
  track_script {
    chk_nxlog
  }
}
